# Runtime configuration for ga-wdm (copy and customize — NOT baked into the image).
#
# Docker:
#   docker run --rm --env-file docker/env.example -v $PWD/runs:/work ga-wdm:latest run-ga
#
# Kubernetes: see docker/k8s/ga-config.yaml
#
# Install paths (fixed by image layout — change only if you relocate mounts):
GA_CLASS_DIR=/opt/ga-project/class
CLIENT_ROOT=/opt/client_public
COBAYA_PACKAGES_PATH=/opt/cobaya_packages

# Where logs and gen_* model dirs are written (mount your PVC here):
GA_PROJECT_ROOT=/work
GA_OUTPUT_DIR=/work

# Likelihood backend: client | cobaya
GA_LIKELIHOOD=client

# Cobaya YAML stem in class/scripts/cobaya_configs/
# sn_desi = Pantheon+SH0ES + DESI DR2
GA_COBAYA_CONFIG=sn_desi

# CLiENT profile during GA: ga_fast | ga_fast_gpu | ga_converge | ga_accurate
# Use ga_converge on HPC for full R-1 training rounds per model
CLIENT_PROFILE=ga_converge

# After GA finishes: long CLiENT + GetDist on the winning model (automatic).
# GA_POST_PROFILE=ga_final_hpc on cluster; ga_final on a laptop.
# Set GA_RUN_POST=0 to skip auto post-GA and run `python post_ga.py` later.
GA_RUN_POST=1
GA_POST_PROFILE=ga_final_hpc

# GA fitness / selection: dic (paper default) | bic | aic | chi2
# DIC = 2*Dbar - Dhat (Spiegelhalter); see docs/FITNESS_AND_SELECTION.md
GA_FITNESS_METRIC=dic
GA_BIC_N_DATA=1600
# Fail if 95% CI covers ≥ this fraction of the prior width
GA_UNCONSTRAINED_FRAC=0.85
GA_REQUIRE_CONSTRAINED=1

# GPU: auto | force (1) | cpu (0)
GA_CLIENT_GPU=auto
CLIENT_TF_GPU_ALLOW_GROWTH=1
CLIENT_TF_LOG_LEVEL=2

# Cobaya serial mode (recommended in containers)
COBAYA_NOMPI=1

# Re-validate best CLiENT point with one true Cobaya call: 1 | 0
CLIENT_VALIDATE_MAP=1

# Auto-upgrade ga_fast → ga_fast_gpu when GPU detected: 1 | 0
GA_CLIENT_AUTO_GPU_PROFILE=1

# Parallel models per generation (match GPU count for best utilisation)
GA_PARALLEL_WORKERS=2
GA_GPU_IDS=0,1

# Generation-0 catalogue: canonical_five | canonical_plus_enumerate | enumerate | full
GA_INITIAL_CATALOG=canonical_plus_enumerate
# INITIAL_POP_SIZE in GA_MCMC_new.py is set to GA_POP_SIZE (must stay aligned)
GA_POP_SIZE=20
GA_NUM_GENERATIONS=40

# Python
PYTHONUNBUFFERED=1
